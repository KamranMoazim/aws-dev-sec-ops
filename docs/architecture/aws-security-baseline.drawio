1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="trail" target="cwl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="176"/><mxPoint x="760" y="254"/></Array></mxGeometry></mxCell><mxCell id="e_cfg_h" value="2 control checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.75;entryX=0;entryY=0.25;" edge="1" parent="1" source="config" target="hub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="306"/><mxPoint x="780" y="342"/></Array></mxGeometry></mxCell><mxCell id="e_wl_gd" value="runtime events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="w_agent" target="gd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="485"/><mxPoint x="460" y="424"/></Array></mxGeometry></mxCell><mxCell id="e_gd_h" value="3 findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="gd" target="hub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="424"/><mxPoint x="780" y="366"/></Array></mxGeometry></mxCell><mxCell id="e_gd_eb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="gd" target="eb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="443"/><mxPoint x="720" y="504"/></Array></mxGeometry></mxCell><mxCell id="e_h_eb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hub" target="eb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_eb_sns" value="4 alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eb" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_sns_mail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sns" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1450" height="130" as="geometry"/></mxCell><mxCell id="lg_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="668" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_flow" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1 CloudTrail records every API call to S3 and CloudWatch Logs&lt;br&gt;2 Config inventory drives Security Hub control checks&lt;br&gt;3 GuardDuty findings flow into Security Hub&lt;br&gt;4 high and critical findings are emailed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="690" width="420" height="95" as="geometry"/></mxCell><mxCell id="lg_scp" value="&lt;b&gt;Service control policies&lt;/b&gt; (docs/security/scp)&lt;br&gt;Deny leaving the organization, deny unapproved regions, protect&lt;br&gt;CloudTrail, Config, GuardDuty and Security Hub from being disabled.&lt;br&gt;Documented, not attached: SCPs never apply to the management account." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="480" height="95" as="geometry"/></mxCell><mxCell id="lg_guard" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;The infra pipeline is denied this root's state.&lt;br&gt;Config's service-linked role is referenced, not managed,&lt;br&gt;so a destroy never removes an account-wide role." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="460" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>