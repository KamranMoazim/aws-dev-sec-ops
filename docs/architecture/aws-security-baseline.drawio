<mxfile host="app.diagrams.net"><diagram id="aws-security-baseline" name="Security Baseline (Step 10)"><mxGraphModel dx="1500" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="810" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Security Baseline - audit, detection, posture, alerting (Step 10)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="CloudTrail (all regions) + AWS Config feed one KMS-encrypted log bucket | GuardDuty and Security Hub (Foundational Best Practices) detect | EventBridge routes high and critical findings to email" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=12;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="work" value="Workload accounts (today: same account)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;fillColor=none;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fontColor=#CD2264;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="560" as="geometry"/></mxCell><mxCell id="w_dev" value="&lt;b&gt;dev&lt;/b&gt; ECS Fargate + RDS&lt;br&gt;(always on)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;labelPosition=