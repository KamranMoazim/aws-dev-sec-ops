tColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="66" y="1036" width="200" height="20" as="geometry"/></mxCell><mxCell id="v76" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=none;strokeColor=#DD3522;dashed=1;" vertex="1" parent="1"><mxGeometry x="34" y="1062" width="26" height="16" as="geometry"/></mxCell><mxCell id="v77" value="Security group (see table)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="66" y="1060" width="200" height="20" as="geometry"/></mxCell><mxCell id="v78" value="&lt;b&gt;Numbered flows&lt;/b&gt;&lt;br&gt;1 Users -&gt; IGW -&gt; ALB (HTTP/HTTPS)&lt;br&gt;2 ALB -&gt; ECS tasks :3000&lt;br&gt;3 ECS tasks -&gt; RDS :5432 (TLS)&lt;br&gt;4 ECS tasks -&gt; NAT -&gt; IGW -&gt; ECR / Secrets Manager / CloudWatch (443)&lt;br&gt;5 Image layers via S3 gateway endpoint (no NAT cost)&lt;br&gt;6 VPC flow logs -&gt; CloudWatch Logs (KMS encrypted)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="280" y="960" width="400" height="132" as="geometry"/></mxCell><mxCell id="v79" value="&lt;b&gt;Dev vs Prod&lt;/b&gt;&lt;br&gt;Dev: single NAT + single-AZ RDS&lt;br&gt;Prod: NAT per AZ + Multi-AZ RDS + WAF&lt;br&gt;&lt;br&gt;Dashed / faded shapes: capacity that scales in or is enabled only in prod." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="960" width="310" height="100" as="geometry"/></mxCell><mxCell id="v80" value="&lt;b&gt;Security groups&lt;/b&gt;&lt;table style='font-size:10px;border-collapse:collapse;margin-top:4px;' cellpadding='3'&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #DD3522;'&gt;&lt;b&gt;SG&lt;/b&gt;&lt;/td&gt;&lt;td style='border-bottom:1px solid #DD3522;'&gt;&lt;b&gt;Inbound&lt;/b&gt;&lt;/td&gt;&lt;td style='border-bottom:1px solid #DD3522;'&gt;&lt;b&gt;Outbound&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;alb-sg&lt;/b&gt;&lt;/td&gt;&lt;td&gt;80, 443 from 0.0.0.0/0&lt;/td&gt;&lt;td&gt;3000 to app-sg&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;app-sg&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3000 from alb-sg&lt;/td&gt;&lt;td&gt;443 to 0.0.0.0/0, 5432 to VPC (10.10.0.0/16)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;db-sg&lt;/b&gt;&lt;/td&gt;&lt;td&gt;5432 from app-sg only&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;default SG&lt;/b&gt;&lt;/td&gt;&lt;td&gt;no rules (deny all)&lt;/td&gt;&lt;td&gt;no rules (deny all)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD3522;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1040" y="938" width="865" height="162" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
