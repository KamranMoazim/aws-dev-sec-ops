elPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1690" y="515" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod_erb" value="rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;exitX=0.5;exitY=1;entryX=0.45;entryY=0;" edge="1" parent="1" source="prod_cw" target="prod_cluster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="prod_alb" target="prod_l443"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod_e2" value="100%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="prod_l443" target="prod_blue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod_e3" value="test" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="prod_l8443" target="prod_green"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_dep_s" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=0;entryX=0;entryY=0.2;" edge="1" parent="1" source="s4_b0" target="staging_cluster"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="150"/><mxPoint x="1310" y="150"/><mxPoint x="1310" y="211"/></Array></mxGeometry></mxCell><mxCell id="e_dep_p" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.7;entryX=0;entryY=0.2;" edge="1" parent="1" source="s6_b0" target="prod_cluster"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="284"/><mxPoint x="1305" y="606"/></Array></mxGeometry></mxCell><mxCell id="pipe_alerts" value="&lt;b&gt;Pipeline alerts&lt;/b&gt; (SNS)&lt;br&gt;execution failed, both&lt;br&gt;pipelines (CodeStar rules)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1090" y="680" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1890" height="130" as="geometry"/></mxCell><mxCell id="lg_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="888" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_flow" value="&lt;b&gt;Numbered flow&lt;/b&gt;&lt;br&gt;1 cut release/x.y.z from develop, bump version&lt;br&gt;2 push starts the release pipeline&lt;br&gt;3 security gates + build once (immutable SHA tag)&lt;br&gt;4 staging blue/green deploy, smoke, ZAP DAST" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="912" width="330" height="100" as="geometry"/></mxCell><mxCell id="lg_flow2" value="&lt;br&gt;5 approval email via SNS; approve in the console&lt;br&gt;6 prod blue/green deploy, smoke, tag recorded&lt;br&gt;7 alarm during bake (5xx, unhealthy, p99): ECS rolls back&lt;br&gt;9 merge release into main, tag vX.Y.Z, back-merge" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="912" width="330" height="100" as="geometry"/></mxCell><mxCell id="lg_bg" value="&lt;b&gt;ECS native blue/green (no CodeDeploy)&lt;/b&gt;&lt;br&gt;The new revision starts in the idle target group (blue and green alternate on every deploy); the :8443 test rule reaches it first (VPC only).&lt;br&gt;ECS then flips the :443 production rule weights to it in one step and keeps the old revision running for the bake time,&lt;br&gt;so a rollback is a weight flip. After the bake, the old tasks stop. Circuit breaker rolls back failed deployments." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="912" width="620" height="90" as="geometry"/></mxCell><mxCell id="lg_cost" value="&lt;b&gt;Cost control&lt;/b&gt;&lt;br&gt;Staging and prod are created for a release and destroyed when idle&lt;br&gt;(make tf-destroy ENV=staging / ENV=prod). Single account today; the env roots accept deploy_role_arn for one account per env." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="912" width="540" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>