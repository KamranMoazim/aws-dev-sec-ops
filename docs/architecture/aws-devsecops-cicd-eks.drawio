" width="52" height="52" as="geometry"/></mxCell><mxCell id="iacnote" value="Provisions VPC, EKS, ECR, RDS and IAM in every account (dev · staging · prod). PR → plan posted as review comment → approval → apply. Policy-as-code checks (Checkov) gate every plan." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=6;" vertex="1" parent="iac"><mxGeometry x="12" y="160" width="540" height="80" as="geometry"/></mxCell><mxCell id="sec" value="Secrets &amp;amp; Access" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FDF2F3;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="acc_tools"><mxGeometry x="600" y="300" width="300" height="250" as="geometry"/></mxCell><mxCell id="secrets" value="Secrets&lt;br&gt;Manager" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="sec"><mxGeometry x="20" y="48" width="52" height="52" as="geometry"/></mxCell><mxCell id="kms" value="KMS&lt;br&gt;CMKs" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="sec"><mxGeometry x="123" y="48"