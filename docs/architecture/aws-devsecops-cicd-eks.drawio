<mxfile host="app.diagrams.net"><diagram id="aws-devsecops" name="AWS DevSecOps"><mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1110" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;DevSecOps Delivery Platform on AWS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#545B64'&gt;CI/CD · Git governance · Terraform IaC · Docker &amp;amp; Amazon EKS · DevSecOps scanning · Observability · Approvals &amp;amp; rollback&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="50" as="geometry"/></mxCell><mxCell id="gitgrp" value="Source Control &amp;amp; Git Governance" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F7F7F7;strokeColor=#545B64;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="255" height="480" as="geometry"/></mxCell><mxCell id="devs" value="Developers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="gitgrp"><mxGeometry x="101" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="git" value="Git Repository&lt;br&gt;(GitHub / GitLab)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="gitgrp"><mxGeometry x="108" y="170" width="40" height="52" as="geometry"/></mxCell><mxCell id="gitnote" value="&lt;b&gt;Branching strategy&lt;/b&gt;&lt;br&gt;main · develop · feature/* · release/* · hotfix/*&lt;br&gt;&lt;br&gt;&lt;b&gt;Code review policy&lt;/b&gt;&lt;br&gt;• Protected main &amp;amp; develop&lt;br&gt;• PR required, 2 approvals + CODEOWNERS&lt;br&gt;• Required status checks (build, tests, scans)&lt;br&gt;• Signed commits, no force-push&lt;br&gt;• Semantic version tags on release" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=6;" vertex="1" parent="gitgrp"><mxGeometry x="10" y="270" width="240" height="290" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud  (AWS Organizations · multi-account)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;fillColor=none;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1580" height="1020" as="geometry"/></mxCell><mxCell id="acc_tools" value="Shared Services / CI-CD Account" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;fillColor=none;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fontColor=#CD2264;" vertex="1" parent="cloud"><mxGeometry x="20" y="30" width="920" height="570" as="geometry"/></mxCell><mxCell id="pipe" value="AWS CodePipeline (V2) — release pipeline" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FDF4FD;strokeColor=#C925D1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#C925D1;" vertex="1" parent="acc_tools"><mxGeometry x="20" y="40" width="880" height="240" as="geometry"/></mxCell><mxCell id="src" value="Source&lt;br&gt;(CodeConnections&lt;br&gt;webhook)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="pipe"><mxGeometry x="30" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="build" value="CodeBuild&lt;br&gt;build · unit tests" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="pipe"><mxGeometry x="180" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="scan" value="CodeBuild — DevSecOps&lt;br&gt;SAST · SCA · secrets&lt;br&gt;Trivy · Checkov" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="pipe"><mxGeometry x="330" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="ecr" value="A