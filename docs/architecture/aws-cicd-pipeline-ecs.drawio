-dev-sec-ops" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="474" width="158" height="44" as="geometry"/></mxCell><mxCell id="v11" value="Shared / CI-CD account" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;fillColor=none;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fontColor=#CD2264;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="1310" height="830" as="geometry"/></mxCell><mxCell id="v12" value="Dev account (us-east-1)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;fillColor=none;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fontColor=#CD2264;" vertex="1" parent="1"><mxGeometry x="1640" y="70" width="270" height="830" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;AWS CodeConnections&lt;/b&gt;&lt;br&gt;devsecops-github&lt;br&gt;(GitHub App)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codestar;" vertex="1" parent="1"><mxGeometry x="290" y="291" width="48" height="48" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Trigger:&lt;/b&gt; push to develop | paths: app/**, buildspecs/**, scripts/** (docs and infra changes do not trigger)" style="rounded=1;arcSize