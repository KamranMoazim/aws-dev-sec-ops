tyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v44" target="v62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1585" y="282"/><mxPoint x="1585" y="177"/></Array></mxGeometry></mxCell><mxCell id="e84" value="7 smoke&lt;br&gt;test" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v46" target="v66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1605" y="385"/><mxPoint x="1605" y="300"/></Array></mxGeometry></mxCell><mxCell id="e85" value="8 record released tag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#E7157B;" edge="1" parent="1" source="v48" target="v68"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e86" value="ECS pulls image by tag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.75;exitY=1;entryX=0;entryY=0.8;strokeColor=#ED7100;jumpStyle=arc;jumpSize=10;fontStyle=0;" edge="1" parent="1" source="v53" target="v62"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1076" y="785"/><mxPoint x="1625" y="785"/><mxPoint x="1625" y="218"/></Array></mxGeometry></mxCell><mxCell id="e87" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.2;entryX=0.06;entryY=1;fontStyle=0;dashed=1;dashPattern=6 4;strokeColor=#7B42BC;fontColor=#7B42BC;endArrow=open;endFill=0;" edge="1" parent="1" source="v61" target="v15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="459" y="640"/></Array></mxGeometry></mxCell><mxCell id="e88" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;entryX=0.25;entryY=1;fontStyle=0;dashed=1;dashPattern=6 4;strokeColor=#7B42BC;fontColor=#7B42BC;endArrow=open;endFill=0;" edge="1" parent="1" source="v61" target="v53"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="770"/><mxPoint x="1052" y="770"/></Array></mxGeometry></mxCell><mxCell id="v89" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="920" width="1890" height="120" as="geometry"/></mxCell><mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="958" as="sourcePoint"/><mxPoint x="96" y="958" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v91" value="Pipeline flow (numbered steps)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="104" y="948" width="200" height="20" as="geometry"/></mxCell><mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontStyle=1;dashed=1;dashPattern=6 4;strokeColor=#7B42BC;fontColor=#7B42BC;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="986" as="sourcePoint"/><mxPoint x="96" y="986" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v93" value="Terraform / config relationship" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="104" y="976" width="200" height="20" as="geometry"/></mxCell><mxCell id="v94" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;strokeWidth=1.5;fontSize=10;fontColor=#777777;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="1004" width="60" height="22" as="geometry"/></mxCell><mxCell id="v95" value="Planned in later steps (7, 9)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="104" y="1005" width="200" height="20" as="geometry"/></mxCell><mxCell id="v96" value="&lt;b&gt;Numbered flow&lt;/b&gt;&lt;br&gt;1 merge feature/* into develop&lt;br&gt;2 webhook via CodeConnections starts the pipeline&lt;br&gt;3 security gates (Scan stage: secrets, SAST, SCA, IaC)&lt;br&gt;4 build + test + Trivy image scan (CodeBuild)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="942" width="330" height="90" as="geometry"/></mxCell><mxCell id="v97" value="&lt;br&gt;5 push image to ECR (immutable tag = short SHA)&lt;br&gt;6 deploy to ECS dev (rolling, circuit breaker rollback)&lt;br&gt;7 smoke test through the ALB (commit == IMAGE_TAG)&lt;br&gt;8 record released tag in SSM parameter" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="690" y="942" width="330" height="90" as="geometry"/></mxCell><mxCell id="v98" value="&lt;b&gt;Build once, deploy many&lt;/b&gt;&lt;br&gt;The image is built and tested once; every deploy references the same immutable tag.&lt;br&gt;Terraform envs/dev reads the released tag from SSM, so an infra apply keeps the image the pipeline last deployed.&lt;br&gt;&lt;b&gt;Security gates&lt;/b&gt;: source scans fail the pipeline before any build; the image scan blocks the push to ECR." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1050" y="942" width="840" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
