itY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5_b0" target="dev_env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_guard" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_b0" target="dev_ssm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="788" y="195"/><mxPoint x="1355" y="195"/><mxPoint x="1355" y="424"/></Array></mxGeometry></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="1880" height="110" as="geometry"/></mxCell><mxCell id="lg_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="722" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_flow" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1 merge an infra change into develop&lt;br&gt;2 webhook starts the pipeline (QUEUED)&lt;br&gt;3 apply only after approval, only the approved plan" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="745" width="330" height="80" as="geometry"/></mxCell><mxCell id="lg_guard" value="&lt;b&gt;Why the guard&lt;/b&gt;&lt;br&gt;Between an app deploy and its smoke test the released tag in SSM still points at the old image;&lt;br&gt;a plan taken then would roll the service back. The plan stops until the app pipeline finishes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="745" width="620" height="80" as="geometry"/></mxCell><mxCell id="lg_iam" value="&lt;b&gt;Least privilege&lt;/b&gt;&lt;br&gt;Validate: no AWS access. Plan: read-only + state lock. Apply: PowerUserAccess + IAM limited to devsecops-* roles.&lt;br&gt;A saved plan fails if state changed after approval." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="745" width="840" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>