# Copy to backend.hcl and fill from `terraform output backend_config` in infra/aws/bootstrap.
# Each root module sets its own `key` in its backend block.
bucket       = "devsecops-tfstate-111111111111-us-east-1"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:111111111111:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
